#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
source setup/lib.sh

usage() {
  cat <<'EOF'
./build_app            build formweb's desktop app from this folder, start to finish
  --no-install         macOS: leave the built app where it is instead of copying it to Applications
  --install            Linux: install the built .deb with apt (asks for your password)
  --open               open the app when the build is done
  --clean              rebuild the Rust side and the frozen engine from nothing
Every step's output goes to build_app.log beside this file.
EOF
}

install_app=auto open_app=0 clean=0
for arg in "$@"; do
  case "$arg" in
    --no-install) install_app=no ;;
    --install) install_app=yes ;;
    --open) open_app=1 ;;
    --clean) clean=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

log="$FORMWEB_ROOT/build_app.log"
: > "$log"
exec > >(tee -a "$log") 2>&1
trap 'status=$?; [ $status -eq 0 ] || printf "\n[formweb] the build stopped (exit %s). The full log is %s\n" "$status" "$log"' EXIT

die() { fw_say "$*" >&2; exit 1; }
step() { printf '\n[formweb] == %s\n' "$*"; }
case "$(uname -s)" in Darwin) os=macos ;; Linux) os=linux ;; *) die "build_app runs on macOS and Linux; on Windows run build_app.bat" ;; esac

step "checking the tools"
if [ "$os" = macos ]; then
  xcode-select -p >/dev/null 2>&1 || die "the Xcode command line tools are missing: run xcode-select --install, then ./build_app again"
fi
command -v python3 >/dev/null 2>&1 || die "Python 3.12 or newer is required (on macOS: brew install python)"
python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' || die "Python $(python3 -V) is too old; 3.12 or newer is required"
command -v node >/dev/null 2>&1 || die "Node 22.12 or newer is required (on macOS: brew install node)"
node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>22||(a===22&&b>=12)?0:1)' || die "Node $(node -v) is too old; 22.12 or newer is required"
if [ -z "$FORMWEB_CARGO" ]; then
  fw_say "installing Rust with rustup (https://rustup.rs) into ~/.cargo; your shell profile is not changed"
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable --no-modify-path
  export PATH="$HOME/.cargo/bin:$PATH"
  FORMWEB_CARGO="$HOME/.cargo/bin/cargo"
  export FORMWEB_CARGO
fi
fw_say "python $(python3 -c 'import platform; print(platform.python_version())'), node $(node -v), $(rustc -V), $("$FORMWEB_CARGO" -V)"
if command -v claude >/dev/null 2>&1; then
  fw_say "Claude Code $(claude --version 2>/dev/null | awk '{print $1}') found; the app's agent dock can start it"
else
  fw_say "Claude Code is not installed; the app builds without it, and its Claude button says how to get it (https://claude.com/claude-code)"
fi

step "installing the engine, the API and the editor"
setup/install
step "installing the desktop packages (PyInstaller) and checking the Tauri toolchain"
setup/install_desktop

if [ "$clean" = 1 ]; then
  step "cleaning earlier builds"
  ( cd src-tauri && "$FORMWEB_CARGO" clean )
  rm -rf backend/build backend/dist-engine src-tauri/binaries/formweb-engine-*
fi

step "building the engine and the editor"
setup/build
step "freezing the API into the app's sidecar"
setup/freeze_backend

tauri=(npx --yes @tauri-apps/cli@2 build --config '{"bundle":{"externalBin":["binaries/formweb-engine"]}}')
case "$os" in
  macos)
    tauri+=(--bundles app)
    [ -n "${APPLE_SIGNING_IDENTITY:-}" ] || tauri+=(--config '{"bundle":{"macOS":{"signingIdentity":"-"}}}')
    ;;
  linux) tauri+=(--bundles "${FORMWEB_BUNDLES:-deb}") ;;
esac

step "building the desktop app (the first build compiles several hundred Rust crates)"
tlog="$(mktemp)"
if ! ( cd src-tauri && "${tauri[@]}" ) 2>&1 | tee "$tlog"; then
  grep -Eq 'error\[E|could not compile' "$tlog" || die "tauri build failed outside the Rust compile; see the lines above"
  fw_say "the Rust compile failed; cleaning src-tauri/target and trying once more"
  ( cd src-tauri && "$FORMWEB_CARGO" clean )
  ( cd src-tauri && "${tauri[@]}" ) || die "tauri build failed twice; send build_app.log"
fi
rm -f "$tlog"

bundle="$FORMWEB_ROOT/src-tauri/target/release/bundle"
version="$(cat VERSION)"

if [ "$os" = macos ]; then
  product=FormWeb
  app="$bundle/macos/$product.app"
  [ -d "$app" ] || die "the build finished but $app is missing"
  codesign --verify --deep --strict "$app" 2>/dev/null || fw_say "codesign could not verify the app; it is ad-hoc signed, so macOS may ask once before it opens"
  step "packing the disk image"
  mkdir -p "$bundle/dmg"
  dmg="$bundle/dmg/${product}_${version}_$(uname -m).dmg"
  stage="$(mktemp -d)"
  ditto "$app" "$stage/$product.app"
  ln -s /Applications "$stage/Applications"
  rm -f "$dmg"
  hdiutil create -quiet -volname "$product" -srcfolder "$stage" -ov -format UDZO "$dmg"
  rm -rf "$stage"
  fw_say "app: $app"
  fw_say "disk image: $dmg"
  target_app=""
  if [ "$install_app" != no ]; then
    dest=/Applications
    [ -w "$dest" ] || { dest="$HOME/Applications"; mkdir -p "$dest"; }
    if pgrep -x formweb >/dev/null 2>&1; then
      osascript -e "tell application \"$product\" to quit" >/dev/null 2>&1 || true
      sleep 2
    fi
    rm -rf "$dest/$product.app"
    ditto "$app" "$dest/$product.app"
    xattr -dr com.apple.quarantine "$dest/$product.app" 2>/dev/null || true
    target_app="$dest/$product.app"
    fw_say "installed: $target_app"
  fi
  if [ "$open_app" = 1 ]; then open "${target_app:-$app}"; fi
else
  deb="$(ls -t "$bundle"/deb/*.deb 2>/dev/null | head -1 || true)"
  [ -n "$deb" ] && fw_say "package: $deb"
  if [ "$install_app" = yes ] && [ -n "$deb" ]; then
    sudo apt install -y "$deb"
  elif [ -n "$deb" ]; then
    fw_say "install it with: sudo apt install $deb   (or run ./build_app --install)"
  fi
  if [ "$open_app" = 1 ]; then
    if [ "$(command -v formweb 2>/dev/null)" = /usr/bin/formweb ]; then nohup /usr/bin/formweb >/dev/null 2>&1 & else "$FORMWEB_ROOT/src-tauri/target/release/formweb" >/dev/null 2>&1 & fi
  fi
fi
fw_say "done in ${SECONDS}s"
