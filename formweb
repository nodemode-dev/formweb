#!/usr/bin/env bash
set -e
export FORMWEB_CWD="${FORMWEB_CWD:-$PWD}"
cd "$(dirname "$0")"
cmd="${1:-boot}"
[ $# -eq 0 ] || shift
case "$cmd" in
  install) exec setup/install "$@" ;;
  install-core) exec setup/install_core "$@" ;;
  install-frontend) exec setup/install_frontend "$@" ;;
  install-backend) exec setup/install_backend "$@" ;;
  boot|dev) exec setup/boot "$@" ;;
  backend) exec setup/boot_backend "$@" ;;
  frontend) exec setup/boot_frontend "$@" ;;
  build) exec setup/build "$@" ;;
  serve) exec setup/serve "$@" ;;
  mcp) source setup/lib.sh; exec "$FORMWEB_PYTHON" setup/mcp_stdio.py "$@" ;;
  agents) source setup/lib.sh; exec "$FORMWEB_PYTHON" setup/agents.py "$@" ;;
  comparisons) source setup/lib.sh; exec "$FORMWEB_PYTHON" setup/comparisons.py "$@" ;;
  run) source setup/lib.sh; exec "$FORMWEB_PYTHON" setup/run.py "$@" ;;
  i18n) source setup/lib.sh; [ "${1:-check}" = check ] && { [ $# -eq 0 ] || shift; exec "$FORMWEB_PYTHON" setup/i18n_check.py "$@"; }; fw_say 'usage: ./formweb i18n check [--json]' >&2; exit 2 ;;
  render) source setup/lib.sh
    bin="native/crates/formweb-render/target/release/formweb-render"
    if [ ! -x "$bin" ]; then fw_say 'building the GPU renderer (first use)' >&2; "$FORMWEB_CARGO" build --release --manifest-path native/crates/formweb-render/Cargo.toml >&2; fi
    exec "$bin" "$@" ;;
  desktop) source setup/lib.sh
    [ "${1:-}" = build ] && { shift; exec ./build_app "$@"; }
    [ -f frontend/dist/index.html ] || { fw_say 'run ./formweb build first; the desktop shell serves the built editor' >&2; exit 1; }
    FORMWEB_ROOT="$PWD" exec "$FORMWEB_CARGO" run --manifest-path src-tauri/Cargo.toml "$@" ;;
  build-app) exec ./build_app "$@" ;;
  install-desktop) exec setup/install_desktop "$@" ;;
  doctor) exec setup/doctor "$@" ;;
  help|-h|--help)
    cat <<'HELP'
formweb · visual website authoring

Usage: ./formweb COMMAND
  install             install Rust core, backend and frontend
  install-core        compile the Rust document engine
  install-backend     install Python dependencies into backend/venv
  install-frontend    install frontend dependencies from the lockfile
  boot                run API 8240 and Vite 5240 together
  backend             run the development API on 127.0.0.1:8240
  frontend            run Vite on localhost:5240
  build               compile Rust, TypeScript/Vite and Python source
  serve               serve the built editor on 127.0.0.1:8240
  mcp                 proxy stdio MCP into the running API
  agents sync         mirror .claude/skills to .agents/skills
  agents sync --check  report drift without changing files
  agents install      show project client wiring; no global changes
  i18n check          every interface language has one entry per English key (--json)
  comparisons status  is the release comparison in the FormAI matrix (--json)
  comparisons build   render the family-format page from docs/comparisons/data (--check, --json)
  comparisons embed  add the release comparison to the matrix (--check, --json)
  run COMMAND [k=v]   apply one engine command to the open site (--list, --json)
  render probe        GPU renderer: adapter and budget; also thumb IN OUT, diff A B OUT (JSON)
  desktop             open the Tauri desktop shell (starts ./formweb serve if needed)
  build-app           build the desktop app start to finish (same as ./build_app, or desktop build)
  install-desktop     install PyInstaller and check the Tauri toolchain
  doctor             inspect tools, installs and service ports
  help                this message

Enable Agents in the editor before using MCP.
HELP
    ;;
  *) printf '[formweb] unknown command: %s\n' "$cmd" >&2; exit 2 ;;
esac
