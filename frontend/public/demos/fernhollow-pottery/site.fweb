    "pages": [
      {
        "id": "home",
        "name": "Home",
        "root": "root",
        "seo": {
          "description": "Mugs, bowls, jugs and vases thrown by hand at Fernhollow Farm. Browse the pots and order by email; no checkout, no fuss.",
          "noindex": false,
          "title": "Fernhollow Pottery: handmade stoneware"
        },
        "slug": "/"
      },
      {
        "id": "shop",
        "name": "Shop",
        "root": "shop-root",
        "seo": {
          "description": "Six handmade stoneware pieces made all year round: a tall jug, everyday mug, breakfast bowl, bud vase, dinner plate and herb planter.",
          "noindex": false,
          "title": "Shop the pots · Fernhollow Pottery"
        },
        "slug": "/shop"
      },
      {
        "id": "product",
        "name": "Product",
        "root": "product-root",
        "seo": {
          "description": "A handmade pot from Fernhollow Pottery.",
          "noindex": false,
          "title": "Product · Fernhollow Pottery"
        },
        "slug": "/shop/product"
      },
      {
        "id": "about",
        "name": "About",
        "root": "about-root",
        "seo": {
          "description": "Fernhollow Pottery is Nell Harrow's workshop in an old hay barn on Ashcombe Lane: how a mug is made and when to visit.",
          "noindex": false,
          "title": "About the workshop · Fernhollow Pottery"
        },
        "slug": "/about"
      },
      {
        "id": "order",
        "name": "How to order",
        "root": "order-root",
        "seo": {
          "description": "Order by email in four steps: choose, write to us, pay by bank transfer and receive your pots. Postage, breakages and returns.",
          "noindex": false,
          "title": "How to order · Fernhollow Pottery"
        },
        "slug": "/order"
      },
      {
        "id": "not-found",
        "name": "Not found",
