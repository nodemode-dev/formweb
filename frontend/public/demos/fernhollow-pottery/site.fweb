          "id": "products",
          "items": [
            {
              "id": "product-tall-jug",
              "slug": "tall-jug",
              "status": "published",
              "values": {
                "description": "A tall pouring jug with a pulled lip that does not drip. Good for water at the table, milk on the side or a handful of garden flowers.",
                "glaze": "Celadon",
                "link": "/shop/tall-jug",
                "name": "Tall jug",
                "order": "mailto:orders@fernhollowpottery.example?subject=Order%3A%20Tall%20jug",
                "picture": "/api/assets/326fbf8ca9a64faebd87b4d9edb5b11293aff9c29e4469de83b626c56dbb3cfc.svg",
                "pictured": "Pictured: a tall jug in pale sea-green celadon glaze, with a handle on the right and a small pouring lip.",
                "position": 1,
                "price": "£58",
                "size": "24 cm tall, holds 1.2 litres"
              }
            },
            {
              "id": "product-everyday-mug",
              "slug": "everyday-mug",
              "status": "published",
              "values": {
                "description": "Our most made piece: a straight-sided mug with a wide handle that fits three fingers. Thrown, trimmed and glazed by hand, so no two are quite alike.",
                "glaze": "Iron red",
                "link": "/shop/everyday-mug",
                "name": "Everyday mug",
                "order": "mailto:orders@fernhollowpottery.example?subject=Order%3A%20Everyday%20mug",
                "picture": "/api/assets/f3e30c34be99a1233b37ff8d27f50b767a3451c501a719c37845459598a5943e.svg",
                "pictured": "Pictured: a straight-sided mug in rust-red glaze with the bare clay showing at the foot.",
                "position": 2,
                "price": "£24",
                "size": "9 cm tall, holds 350 ml"
              }
            },
            {
              "id": "product-breakfast-bowl",
              "slug": "breakfast-bowl",
              "status": "published",
              "values": {
                "description": "A deep bowl for porridge, soup or noodles, with a rolled rim that is kind to lips. Stacks neatly in a cupboard.",
                "glaze": "Oatmeal",
                "link": "/shop/breakfast-bowl",
                "name": "Breakfast bowl",
                "order": "mailto:orders@fernhollowpottery.example?subject=Order%3A%20Breakfast%20bowl",
                "picture": "/api/assets/9280ac0f078a05b46ebe2d70cfaad3b5c451a6a89c1144936fe580bc63024abc.svg",
                "pictured": "Pictured: a deep round bowl in speckled oatmeal glaze, seen from the side.",
                "position": 3,
                "price": "£28",
                "size": "15 cm across, 7 cm deep"
              }
            },
            {
              "id": "product-bud-vase",
              "slug": "bud-vase",
              "status": "published",
              "values": {
                "description": "A small narrow-necked vase for one or two stems. Glazed inside so it holds water; sits happily on a windowsill.",
                "glaze": "Cobalt",
                "link": "/shop/bud-vase",
                "name": "Bud vase",
                "order": "mailto:orders@fernhollowpottery.example?subject=Order%3A%20Bud%20vase",
                "picture": "/api/assets/089918ff462e0dd263a4046c0d87c98884943268faf16afc8cdf3b9689fe4e0e.svg",
                "pictured": "Pictured: a small round-bellied vase with a narrow neck, in deep cobalt blue.",
                "position": 4,
                "price": "£22",
                "size": "14 cm tall"
              }
            },
            {
              "id": "product-dinner-plate",
              "slug": "dinner-plate",
              "status": "published",
              "values": {
                "description": "A wide plate with a low rim to keep sauces in their place. Sold singly, so you can build a set slowly.",
                "glaze": "Ash white",
                "link": "/shop/dinner-plate",
                "name": "Dinner plate",
                "order": "mailto:orders@fernhollowpottery.example?subject=Order%3A%20Dinner%20plate",
                "picture": "/api/assets/97e8da1a63ff0c41377d9961f502623522e222e903eafb17fb512e5776d30b8f.svg",
                "pictured": "Pictured: a wide flat plate in soft white glaze with a thin brown rim where the glaze breaks.",
                "position": 5,
                "price": "£34",
                "size": "27 cm across"
              }
            },
            {
              "id": "product-herb-planter",
              "slug": "herb-planter",
              "status": "published",
              "values": {
                "description": "A planter with a drainage hole and its own saucer, sized for a pot of basil or thyme from the market.",
                "glaze": "Moss",
                "link": "/shop/herb-planter",
                "name": "Herb planter",
                "order": "mailto:orders@fernhollowpottery.example?subject=Order%3A%20Herb%20planter",
                "picture": "/api/assets/3173f70c4fb9f505f904b7797424ba71d1b5fb7df0d618759be8948c219f3898.svg",
                "pictured": "Pictured: a flowerpot shape with a matching saucer, in moss-green glaze, holding a small green herb.",
                "position": 6,
                "price": "£40",
                "size": "13 cm tall with its saucer"
              }
            }
          ],
          "name": "Products"
        }
