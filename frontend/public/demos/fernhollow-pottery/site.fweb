            "max-width": "60ch"
          },
          "tag": "p",
          "text": "Fernhollow Pottery is Nell Harrow and a part-time assistant, working in an old hay barn on a sheep farm at the end of Ashcombe Lane."
        },
        "ab-main": {
          "attrs": {},
          "breakpoints": {},
          "children": [
            "ab-hero",
            "ab-steps",
