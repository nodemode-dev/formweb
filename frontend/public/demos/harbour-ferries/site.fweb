      "pages": [
        {
          "id": "home",
          "name": "Home",
          "root": "root",
          "seo": {
            "description": "Timetables, fares and service updates for the five Harbour Ferries routes, 1 May to 30 September 2026. Work out your fare before you travel.",
            "noindex": false,
            "title": "Harbour Ferries: five routes from Town Pier, summer 2026"
          },
          "slug": "/"
        },
        {
          "id": "p-fares",
          "name": "Timetable and fares",
          "root": "p-fares-root",
          "seo": {
            "description": "Departure times for every route and a fare calculator for adults, children, concessions and bicycles.",
            "noindex": false,
            "title": "Timetable and fares · Harbour Ferries"
          },
          "slug": "/fares"
        },
        {
          "id": "p-routes",
          "name": "Routes",
          "root": "p-routes-root",
          "seo": {
            "description": "The five Harbour Ferries routes: crossing times, stops, vessels, first and last sailings.",
            "noindex": false,
            "title": "Routes · Harbour Ferries"
          },
          "slug": "/routes"
        },
        {
          "id": "p-route",
          "name": "Route",
          "root": "p-route-root",
          "seo": {
            "description": "Route details.",
            "noindex": false,
            "title": "Route · Harbour Ferries"
          },
          "slug": "/routes/route"
        },
        {
          "id": "p-updates",
          "name": "Service updates",
          "root": "p-updates-root",
          "seo": {
            "description": "Timetable changes, pier works and weather notices from Harbour Ferries.",
            "noindex": false,
            "title": "Service updates · Harbour Ferries"
          },
          "slug": "/updates"
        },
        {
          "id": "p-search",
          "name": "Search",
          "root": "p-search-root",
          "seo": {
            "description": "Search the Harbour Ferries site for routes, fares, stops, vessels and service updates.",
            "noindex": false,
            "title": "Search · Harbour Ferries"
          },
          "slug": "/search"
        },
        {
          "id": "p-contact",
          "name": "Contact",
          "root": "p-contact-root",
          "seo": {
            "description": "Ask Harbour Ferries about a crossing, a group booking or lost property.",
            "noindex": false,
            "title": "Contact · Harbour Ferries"
          },
          "slug": "/contact"
        },
        {
          "id": "p-404",
          "name": "Not found",
          "root": "p-404-root",
          "seo": {
            "description": "That page is not on the Harbour Ferries site. Search for it or pick a route.",
            "noindex": false,
            "title": "Page not found · Harbour Ferries"
          },
          "slug": "/404"
        }
      ],
      "schemaVersion": 1,
      "settings": {
        "baseUrl": "https://harbourferries.example",
