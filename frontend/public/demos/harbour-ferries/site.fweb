            },
            {
              "name": "order",
              "required": false,
              "type": "number"
            }
          ],
          "id": "routes",
          "items": [
            {
              "id": "route-harbour-loop",
              "slug": "harbour-loop",
              "status": "published",
              "values": {
                "about": "The Loop calls at Town Pier, Fish Quay, the Marina and North Mole, then comes back to Town Pier: 25 minutes all the way round, 4.2 kilometres. It carries more people than any other route, most of them on short hops between Town Pier and the Marina. Two hybrid boats, Tern and Kittiwake, share it, 49 sailings a day in season.",
                "adult": "£3.50",
                "code": "HL",
                "crossing": "25 min loop",
                "first": "06:30",
                "frequency": "Every 20 minutes",
                "last": "22:30",
                "link": "/routes/harbour-loop",
                "minutes": 25,
                "name": "Harbour Loop",
                "order": 1,
                "stops": "Town Pier · Fish Quay · Marina · North Mole",
                "summary": "The circular service around the inner harbour, every 20 minutes from early morning to late evening.",
                "tip": "Change at the Marina for the Lighthouse Run and at North Mole for West Sands.",
                "vessels": "Tern and Kittiwake"
              }
            },
            {
              "id": "route-eastern-quay",
              "slug": "eastern-quay",
              "status": "published",
              "values": {
                "about": "Guillemot shuttles between Town Pier and Eastern Quay every half hour, 1.9 kilometres each way. Weekday mornings and evenings are the busy hours, so the first three boats of the day fill early. There are 62 sailings a day in season, 31 in each direction.",
                "adult": "£2.80",
                "code": "EQ",
                "crossing": "12 min",
                "first": "06:45",
                "frequency": "Every 30 minutes",
                "last": "21:45",
                "link": "/routes/eastern-quay",
                "minutes": 12,
                "name": "Eastern Quay",
                "order": 2,
                "stops": "Town Pier · Eastern Quay",
                "summary": "A twelve-minute commuter crossing to the workshops and housing on the east shore.",
                "tip": "A season pass pays for itself after about forty return trips.",
                "vessels": "Guillemot"
              }
            },
            {
              "id": "route-island-shuttle",
              "slug": "island-shuttle",
              "status": "published",
              "values": {
                "about": "Fulmar and Shearwater cross 9.6 kilometres of open bay to Gull Island, 35 minutes each way, on the hour from 08:00 to 19:00. It is the route most sensitive to weather and the one that grows most at weekends. The last boat back is never cancelled without a notice on the updates page first.",
                "adult": "£7.50",
                "code": "IS",
                "crossing": "35 min",
                "first": "08:00",
                "frequency": "Every 60 minutes",
                "last": "19:00",
                "link": "/routes/island-shuttle",
                "minutes": 35,
                "name": "Island Shuttle",
                "order": 3,
                "stops": "Town Pier · Gull Island",
                "summary": "The hourly boat to Gull Island: beaches, the bird reserve and one cafe.",
                "tip": "Sit on the starboard side going out for the bird cliffs.",
                "vessels": "Fulmar and Shearwater"
              }
            },
            {
              "id": "route-lighthouse-run",
              "slug": "lighthouse-run",
              "status": "published",
              "values": {
                "about": "Petrel runs from the Marina to Skerry Light, 14.8 kilometres out and 50 minutes each way, seven round trips a day in season. Fog and strong wind cancel this route before anything else, so check the updates page on a doubtful morning. There is no shop at the light: bring water.",
                "adult": "£9.00",
                "code": "LR",
                "crossing": "50 min",
                "first": "09:00",
                "frequency": "Every 90 minutes",
                "last": "18:00",
                "link": "/routes/lighthouse-run",
                "minutes": 50,
                "name": "Lighthouse Run",
                "order": 4,
                "stops": "Marina · Skerry Light",
                "summary": "A longer open-water trip from the Marina out to Skerry Light and back.",
                "tip": "The 16:30 sailing has the best light for photographs of the tower.",
                "vessels": "Petrel"
              }
            },
            {
              "id": "route-west-sands",
              "slug": "west-sands",
              "status": "published",
              "values": {
                "about": "Eider, the electric boat, crosses from North Mole to West Sands in 20 minutes, 5.1 kilometres, every 45 minutes from 07:30 to 21:00. The route is quiet in May, steady through the school holidays and popular on clear evenings. She carries 14 bicycles, more than any other boat her size in the fleet.",
                "adult": "£4.20",
                "code": "WS",
                "crossing": "20 min",
                "first": "07:30",
                "frequency": "Every 45 minutes",
                "last": "21:00",
                "link": "/routes/west-sands",
                "minutes": 20,
                "name": "West Sands",
                "order": 5,
                "stops": "North Mole · West Sands",
                "summary": "The crossing from North Mole to the long beach at West Sands.",
                "tip": "On a clear evening take the 19:30 out and the last boat back.",
                "vessels": "Eider"
              }
            }
          ],
          "name": "Routes"
        },
        "updates": {
          "fields": [
            {
              "name": "title",
              "required": true,
              "type": "text"
            },
            {
              "name": "date",
              "required": false,
              "type": "date"
            },
            {
              "name": "when",
              "required": false,
              "type": "text"
            },
            {
              "name": "kind",
              "required": false,
              "type": "text"
            },
            {
              "name": "body",
              "required": false,
              "type": "text"
            }
          ],
          "id": "updates",
          "items": [
            {
              "id": "update-season-end",
              "slug": "season-end",
              "status": "published",
              "values": {
                "body": "The last sailings of the season run on 30 September. All five routes keep their full timetable until then: the last Harbour Loop leaves Town Pier at 22:30 and the last Island Shuttle at 19:00.",
                "date": "2026-09-14",
                "kind": "Timetable",
                "title": "The 2026 season ends on Wednesday 30 September",
                "when": "14 September"
              }
            },
            {
              "id": "update-regatta-record",
              "slug": "regatta-record",
              "status": "published",
              "values": {
                "body": "Sunday 12 July, Harbour Regatta day, was the busiest day we have had: 4,928 riders in clear weather, 1,008 of them on the Island Shuttle. Thank you for queueing so patiently at Town Pier.",
                "date": "2026-07-13",
                "kind": "News",
                "title": "Regatta day set a record: 4,928 riders",
                "when": "13 July"
              }
            },
            {
              "id": "update-turnstone-relief",
              "slug": "turnstone-relief",
              "status": "published",
              "values": {
                "body": "Guillemot is out of service for two days of planned work. The relief vessel Turnstone covers every Eastern Quay sailing; she has 72 seats and 6 bicycle spaces, so bring a bicycle outside the peak if you can.",
                "date": "2026-06-05",
                "kind": "Fleet",
                "title": "Turnstone stands in on Eastern Quay on 9 and 10 June",
                "when": "5 June"
              }
            },
            {
              "id": "update-fog-lighthouse",
              "slug": "fog-lighthouse",
              "status": "published",
              "values": {
                "body": "On Monday 11 May fog cancelled nine sailings. The Lighthouse Run stops first, then the Island Shuttle; the Harbour Loop and Eastern Quay keep sailing on radar. We post the first notice by 06:00.",
                "date": "2026-05-12",
                "kind": "Weather",
                "title": "Fog and the Lighthouse Run: how we decide",
                "when": "12 May"
              }
            },
            {
              "id": "update-eider-back",
              "slug": "eider-back",
              "status": "published",
              "values": {
                "body": "Our electric boat Eider passed her survey on 30 March and returns to the West Sands crossing when the season opens on 1 May, every 45 minutes from 07:30.",
                "date": "2026-04-27",
                "kind": "Fleet",
                "title": "Eider is back on West Sands for the season",
                "when": "27 April"
              }
            }
          ],
          "name": "Service updates"
        }
      },
