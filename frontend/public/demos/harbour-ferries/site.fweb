                {
                  "target": "c-name",
                  "type": "clear"
                },
                {
                  "target": "c-email",
                  "type": "clear"
                },
                {
                  "target": "c-message",
                  "type": "clear"
                }
              ],
              "trigger": "submit"
            }
          },
