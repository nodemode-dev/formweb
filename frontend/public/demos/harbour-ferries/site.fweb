          "status-line": {
            "cursor": true,
            "erase": 60,
            "hold": 2600,
            "speed": 34,
            "strings": [
              "All five routes are running to timetable.",
              "Lighthouse Run: fog watch from 15:00, check before you travel.",
              "Wind south-west, 12 knots. Slight sea in the outer bay.",
              "The 2026 season runs until Wednesday 30 September."
            ],
            "trigger": "view",
            "type": "typewriter"
          },
