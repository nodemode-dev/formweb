      "seo": {
        "redirects": {
          "/news": {
            "status": 302,
            "to": "/updates"
          },
          "/news/*": "/updates",
          "/tickets": "/fares",
          "/timetable": "/fares"
        }
      },
      "variables": {
        "formulas": {
          "adultSingle": "round(lookup(adultFare, route) * if(offpeak, 0.7, 1), 2)",
          "oneWay": "round(passengerCost + vehicleCost, 2)",
          "passengerCost": "round(adults * adultSingle + children * round(lookup(adultFare, route) * 0.5, 2), 2)",
          "saving": "round(oneWay * if(returning, 2, 1) - total, 2)",
          "total": "round(oneWay * if(returning, 1.8, 1), 2)",
          "travelMinutes": "lookup(crossingMin, route) * if(returning, 2, 1)",
          "vehicleCost": "lookup(vehicleFare, vehicle)"
        },
        "inputs": {
          "f-adults": {
            "variable": "adults"
          },
          "f-children": {
            "variable": "children"
          },
          "f-offpeak": {
            "event": "change",
            "variable": "offpeak"
          },
          "f-return": {
            "event": "change",
            "variable": "returning"
          },
          "f-route": {
            "event": "change",
            "variable": "route"
          },
          "f-vehicle": {
            "event": "change",
            "variable": "vehicle"
          }
        },
        "outputs": {
          "calc-l1-v": {
            "decimals": 2,
            "from": "adultSingle",
            "prefix": "£",
            "reserve": 6
          },
          "calc-l2-v": {
            "decimals": 2,
            "from": "passengerCost",
            "prefix": "£",
            "reserve": 6
          },
          "calc-l3-v": {
            "decimals": 2,
            "from": "vehicleCost",
            "prefix": "£",
            "reserve": 6
          },
          "calc-l4-v": {
            "decimals": 2,
            "from": "saving",
            "prefix": "−£",
            "reserve": 7
          },
          "calc-l5-v": {
            "decimals": 0,
            "from": "travelMinutes",
            "reserve": 7,
            "suffix": " min"
          },
          "calc-total": {
            "decimals": 2,
            "from": "total",
            "grouping": true,
            "prefix": "£",
            "reserve": 7
          }
        },
        "tables": {
          "adultFare": {
            "eastern": 2.8,
            "island": 7.5,
            "lighthouse": 9,
            "loop": 3.5,
            "sands": 4.2
          },
          "crossingMin": {
            "eastern": 12,
            "island": 35,
            "lighthouse": 50,
            "loop": 25,
            "sands": 20
          },
          "vehicleFare": {
            "bicycle": 1.5,
            "cargo": 3,
            "none": 0
          }
        },
        "values": {
          "adults": {
            "initial": 2,
            "max": 9,
            "min": 0,
            "step": 1,
            "type": "number"
          },
          "children": {
            "initial": 0,
            "max": 9,
            "min": 0,
            "step": 1,
            "type": "number"
          },
          "offpeak": {
            "initial": false,
            "type": "boolean"
          },
          "returning": {
            "initial": true,
            "type": "boolean"
          },
          "route": {
            "initial": "loop",
            "options": [
              "loop",
              "eastern",
              "island",
              "lighthouse",
              "sands"
            ],
            "type": "text"
          },
          "vehicle": {
            "initial": "none",
            "options": [
              "none",
              "bicycle",
              "cargo"
            ],
            "type": "text"
          }
        }
      }
    },
