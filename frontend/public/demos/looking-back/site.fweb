          "line-height": "1.2",
          "margin": "0 auto",
          "max-width": "24ch",
          "text-align": "center",
          "text-wrap": "balance"
        },
        "tag": "p",
        "text": "They went to study the Moon. The picture everyone remembers is of the place they left."
      },
      "b2": {
        "attrs": {},
        "breakpoints": {},
        "children": [
          "b2-p"
        ],
        "id": "b2",
        "name": "B2",
