          "letter-spacing": "-0.015em",
          "line-height": "1.2",
          "margin": "0 auto",
          "max-width": "24ch",
          "text-align": "center",
          "text-wrap": "balance"
        },
        "tag": "p",
        "text": "The next time, people were told in advance. Some of them went outside and waved."
      },
      "b4": {
        "attrs": {},
        "breakpoints": {},
        "children": [
          "b4-p"
