      "id": "site-a6d472cf3edf3e35be1de8c61a4512d8",
      "locales": {
        "en": {}
      },
      "name": "Looking Back",
      "nodes": {
        "b1": {
          "attrs": {},
          "breakpoints": {},
          "children": [
            "b1-p"
          ],
          "id": "b1",
          "name": "B1",
          "styles": {
            "padding": "clamp(72px, 13vw, 180px) var(--gutter)"
          },
          "tag": "section",
          "text": ""
        },
        "b1-p": {
          "attrs": {},
          "breakpoints": {},
          "children": [],
          "id": "b1-p",
          "name": "B1 p",
          "styles": {
            "font-family": "var(--font-display)",
            "font-size": "clamp(1.625rem, 1rem + 2.6vw, 3rem)",
            "letter-spacing": "-0.015em",
            "line-height": "1.2",
            "margin": "0 auto",
            "max-width": "24ch",
            "text-align": "center",
            "text-wrap": "balance"
          },
          "tag": "p",
          "text": "They went to study the Moon. The picture everyone remembers is of the place they left."
        },
        "b2": {
          "attrs": {},
          "breakpoints": {},
          "children": [
            "b2-p"
          ],
          "id": "b2",
          "name": "B2",
          "styles": {
            "padding": "clamp(72px, 13vw, 180px) var(--gutter)"
          },
          "tag": "section",
          "text": ""
        },
        "b2-p": {
          "attrs": {},
          "breakpoints": {},
          "children": [],
          "id": "b2-p",
          "name": "B2 p",
          "styles": {
            "font-family": "var(--font-display)",
            "font-size": "clamp(1.625rem, 1rem + 2.6vw, 3rem)",
            "letter-spacing": "-0.015em",
            "line-height": "1.2",
            "margin": "0 auto",
            "max-width": "24ch",
            "text-align": "center",
            "text-wrap": "balance"
          },
          "tag": "p",
          "text": "Then the cameras kept going, and the subject kept shrinking."
        },
        "b3": {
          "attrs": {},
          "breakpoints": {},
          "children": [
            "b3-p"
          ],
          "id": "b3",
          "name": "B3",
          "styles": {
            "padding": "clamp(72px, 13vw, 180px) var(--gutter)"
          },
          "tag": "section",
          "text": ""
        },
        "b3-p": {
          "attrs": {},
          "breakpoints": {},
          "children": [],
          "id": "b3-p",
          "name": "B3 p",
          "styles": {
            "font-family": "var(--font-display)",
            "font-size": "clamp(1.625rem, 1rem + 2.6vw, 3rem)",
            "letter-spacing": "-0.015em",
            "line-height": "1.2",
            "margin": "0 auto",
            "max-width": "24ch",
            "text-align": "center",
            "text-wrap": "balance"
          },
          "tag": "p",
          "text": "The next time, people were told in advance. Some of them went outside and waved."
        },
        "b4": {
          "attrs": {},
          "breakpoints": {},
          "children": [
            "b4-p"
          ],
          "id": "b4",
          "name": "B4",
          "styles": {
            "padding": "clamp(72px, 13vw, 180px) var(--gutter)"
          },
          "tag": "section",
          "text": ""
        },
        "b4-p": {
          "attrs": {},
          "breakpoints": {},
          "children": [],
          "id": "b4-p",
          "name": "B4 p",
          "styles": {
            "font-family": "var(--font-display)",
            "font-size": "clamp(1.625rem, 1rem + 2.6vw, 3rem)",
            "letter-spacing": "-0.015em",
            "line-height": "1.2",
            "margin": "0 auto",
            "max-width": "24ch",
            "text-align": "center",
            "text-wrap": "balance"
          },
          "tag": "p",
          "text": "And then, after more than fifty years, there was someone behind the camera again."
        },
        "c1": {
          "attrs": {
            "aria-label": "1968: Earthrise"
          },
          "breakpoints": {},
          "children": [
            "c1-stage"
          ],
          "id": "c1",
