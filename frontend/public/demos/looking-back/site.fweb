          "margin": "0 auto",
          "max-width": "24ch",
          "text-align": "center",
          "text-wrap": "balance"
        },
        "tag": "p",
        "text": "Then the cameras kept going, and the subject kept shrinking."
      },
      "b3": {
        "attrs": {},
        "breakpoints": {},
        "children": [
          "b3-p"
        ],
        "id": "b3",
