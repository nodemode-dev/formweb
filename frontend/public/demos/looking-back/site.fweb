    "pages": [
      {
        "id": "home",
        "name": "Story",
        "root": "root",
        "seo": {
          "description": "A scroll-driven photo essay: six pictures of the Earth made between 1966 and 2026 by cameras that had left it.",
          "noindex": false,
          "title": "Looking Back: six photographs of home, taken from far away"
        },
        "slug": "/"
      },
      {
        "id": "p-gallery",
        "name": "Gallery",
        "root": "p-gallery-root",
        "seo": {
          "description": "Nine photographs of the Earth from orbit, from the Moon and from deep space. Open any frame full size.",
          "noindex": false,
          "title": "Gallery: every frame in the essay · Looking Back"
        },
        "slug": "/gallery"
      },
      {
        "id": "p-notes",
        "name": "Notes",
        "root": "p-notes-root",
        "seo": {
          "description": "Where each photograph comes from, who made it, and how this essay was put together.",
          "noindex": false,
          "title": "Notes and sources · Looking Back"
        },
        "slug": "/notes"
      },
      {
        "id": "p-404",
        "name": "Not found",
        "root": "p-404-root",
        "seo": {
          "description": "That page is not part of this essay.",
          "noindex": false,
          "title": "Out of frame · Looking Back"
        },
        "slug": "/404"
      }
    ],
