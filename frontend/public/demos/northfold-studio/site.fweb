          "tag": "div",
          "text": ""
        },
        "ab-img": {
          "attrs": {
            "alt": "Abstract composition of squares, circles and quarter-circles in black, red, ochre and stone, from the studio's own sketchbook.",
            "decoding": "async",
            "fetchpriority": "high",
            "height": "900",
            "src": "/api/assets/32d0a1342c6ddcad565eb42934ec455203ac0594d9cbc6d4b578bac6d6726863.svg",
            "width": "1200"
          },
          "breakpoints": {},
          "children": [],
          "id": "ab-img",
          "name": "Ab img",
          "styles": {
            "display": "block",
            "height": "auto",
            "max-width": "100%",
            "width": "100%"
          },
          "tag": "img",
          "text": ""
        },
        "ab-lead": {
          "attrs": {},
          "breakpoints": {},
          "children": [],
          "id": "ab-lead",
          "name": "Ab lead",
          "styles": {
            "color": "var(--ink-soft)",
            "font-size": "var(--fs-lead)",
            "line-height": "1.55",
            "margin": "0 0 16px",
            "max-width": "60ch"
          },
          "tag": "p",
          "text": "Northfold Studio is run by Maren Aske, a graphic designer who spent ten years in larger agencies before setting up on her own in 2019."
        },
        "ab-main": {
          "attrs": {},
          "breakpoints": {},
          "children": [
            "ab-hero",
            "ab-process",
            "ab-rec"
          ],
          "id": "ab-main",
          "name": "Ab main",
          "styles": {},
          "tag": "main",
          "text": ""
        },
        "ab-p1": {
          "attrs": {},
          "breakpoints": {},
          "children": [],
          "id": "ab-p1",
          "name": "Ab p1",
          "styles": {
            "color": "var(--ink-soft)",
            "margin": "0 0 16px",
            "max-width": "68ch"
          },
          "tag": "p",
          "text": "Staying small means you talk to the person doing the work, every time. When a project needs more hands, Maren brings in illustrators, writers and developers she has worked with for years."
        },
        "ab-p2": {
          "attrs": {},
          "breakpoints": {},
          "children": [],
          "id": "ab-p2",
          "name": "Ab p2",
          "styles": {
            "color": "var(--ink-soft)",
            "margin": "0 0 16px",
            "max-width": "68ch"
          },
          "tag": "p",
          "text": "The studio is on the top floor of the old Ropewalk Building in Northfold, with a long table, a plan chest and a very good view of the river."
        },
        "ab-process": {
          "attrs": {
            "aria-labelledby": "ab-process-h"
