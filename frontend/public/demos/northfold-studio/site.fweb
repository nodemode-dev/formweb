{
  "format": "com.nodemode.formweb",
  "version": 1,
  "site": {
    "breakpoints": [
      {
        "id": "desktop",
        "maxWidth": 100000,
        "name": "Desktop"
      },
      {
        "id": "tablet",
        "maxWidth": 991,
        "name": "Tablet"
      },
      {
        "id": "mobile",
        "maxWidth": 767,
        "name": "Mobile"
      }
    ],
    "collections": {
      "projects": {
        "fields": [
          {
            "name": "name",
            "required": true,
            "type": "text"
          },
          {
            "name": "client",
            "required": false,
            "type": "text"
          },
          {
            "name": "year",
            "required": false,
            "type": "text"
          },
          {
            "name": "discipline",
            "required": false,
            "type": "text"
          },
          {
            "name": "summary",
            "required": false,
            "type": "text"
          },
          {
            "name": "body1",
            "required": false,
            "type": "text"
          },
          {
            "name": "body2",
            "required": false,
            "type": "text"
          },
          {
            "name": "cover",
            "required": false,
            "type": "image"
          },
          {
            "name": "image2",
            "required": false,
            "type": "image"
          },
          {
            "name": "image3",
            "required": false,
            "type": "image"
          },
          {
            "name": "caption1",
            "required": false,
            "type": "text"
          },
          {
            "name": "caption2",
            "required": false,
            "type": "text"
          },
          {
            "name": "caption3",
            "required": false,
            "type": "text"
          },
          {
            "name": "link",
            "required": false,
            "type": "url"
          },
          {
            "name": "order",
            "required": false,
            "type": "number"
          }
        ],
        "id": "projects",
        "items": [
          {
            "id": "project-quarry-theatre",
            "slug": "quarry-theatre",
            "status": "published",
            "values": {
              "body1": "Quarry Theatre wanted a season that felt like one family of shows, not eight separate campaigns. We built a system of concentric rings, one colour order per production, that works from a bus shelter to a ticket stub.",
              "body2": "Every poster uses the same grid and two typefaces, so the theatre's own team can make new ones in an afternoon. Ticket sales for the autumn season were the best in the theatre's history.",
              "caption1": "The season poster for the opening production, with rings in red, ochre and black.",
              "caption2": "A smaller poster from the same season: the colour order changes, the grid stays.",
              "caption3": "Ticket and programme cover set in the season colours.",
              "client": "Quarry Theatre",
              "cover": "/api/assets/8aacbe23c26b6ccd9116bb14e44fbbf147bc7dc106add9f9b393a40abd13a5d4.svg",
              "discipline": "Posters and campaign",
              "image2": "/api/assets/b60797325cb85938013e16de415e86d276ab93f23fffbc2dec78817bafa3a229.svg",
              "image3": "/api/assets/e04282a8cac2322c259c1ba19e9c26e9f34b1c111ba8849fd88f47514ead6b02.svg",
              "link": "/work/quarry-theatre",
              "name": "Quarry Theatre: 2026 season",
              "order": 1,
              "summary": "Eight posters and a season brochure for a 200-seat theatre in a former stone quarry.",
              "year": "2026"
            }
          },
          {
            "id": "project-orchard-lane",
            "slug": "orchard-lane",
            "status": "published",
            "values": {
              "body1": "Orchard Lane presses apples from four orchards a few miles apart, and each cider tastes of its place. The labels are a family of circles, like apples piled in a crate, with one orchard per colour.",
              "body2": "Printed on uncoated paper with two spot colours, the labels cost less than the old four-colour ones and stand out on a crowded shelf.",
              "caption1": "The dry cider label: green and gold circles behind a bottle-shaped panel.",
              "caption2": "The medium cider label, with a warmer mix of the same circles.",
              "caption3": "Gift box with all four labels side by side.",
              "client": "Orchard Lane Cider",
              "cover": "/api/assets/caba9e0142634dc763dcfcac52213e11d0e1e11338fd56351e647232930af16f.svg",
              "discipline": "Packaging",
              "image2": "/api/assets/580db927922a8819d75aa7bf37e6561ae2897a899b596bc79186189f50e69b9b.svg",
              "image3": "/api/assets/0958826aa419e4c8cd7b5e203d0abae3fc36d2b85ef37a6510ec7b4f7b8fc466.svg",
              "link": "/work/orchard-lane",
              "name": "Orchard Lane Cider labels",
              "order": 2,
              "summary": "A label family for a small cider maker, one illustration for each orchard the apples come from.",
              "year": "2025"
            }
          },
          {
            "id": "project-lantern-books",
            "slug": "lantern-books",
            "status": "published",
            "values": {
              "body1": "Lantern Books asked for covers that would look good one at a time and better together. The spines carry the system: a band, a block and a colour, so a full shelf reads as a pattern.",
              "body2": "We wrote a cover template in the publisher's layout software, with every colour and position set, so the series can keep growing without us.",
              "caption1": "A shelf of Pocket Classics spines in orange, blue and navy.",
              "caption2": "Six front covers from the first year of the series.",
              "caption3": "Close view of the spine band and block on three books.",
              "client": "Lantern Books",
              "cover": "/api/assets/22071fa72a7eb8e7ddc20b935e7ea0ee0981729067ccdbbf499405bd0b473084.svg",
              "discipline": "Book covers and series design",
              "image2": "/api/assets/ab235e39c6dab8c9e41ed5c15ac225a701e3cc85adbcb595ba4f60e126030021.svg",
              "image3": "/api/assets/d2f78c51d23eb506092696ddedad26433cbf3adc852304f8d77c2f003277ae39.svg",
              "link": "/work/lantern-books",
              "name": "Lantern Books: Pocket Classics",
              "order": 3,
              "summary": "Twenty-four covers for a series of classic novels in a small format, designed to be collected.",
              "year": "2025"
            }
          },
          {
            "id": "project-stavemoor-lido",
            "slug": "stavemoor-lido",
            "status": "published",
            "values": {
              "body1": "The swimmers who saved Stavemoor Lido had raised the money themselves, so the identity needed to feel like theirs: bright, simple and easy to paint on a wall. The mark is a sun over five waves, one for each lane.",
              "body2": "The signs are cut from painted aluminium in three colours, and the timetable boards are chalkboards the staff rewrite every week.",
              "caption1": "The Stavemoor Lido mark: a sun over layered waves in teal and navy.",
              "caption2": "The entrance sign and lane markers in the same colours.",
              "caption3": "Season pass cards for adults, children and families.",
              "client": "Stavemoor Lido",
              "cover": "/api/assets/e24165b471f8a763898222976fe20ee9177e0f711aa7b49fbab1ff988498a512.svg",
              "discipline": "Identity and signage",
              "image2": "/api/assets/fe36962912b8de4a79e2ea85e304ad5397ca701b52938ba31cc71c2e07944665.svg",
              "image3": "/api/assets/4cf4d89d02143ca6dea44500d81fda74794cd8fec45dd9a672318e52aa780a26.svg",
              "link": "/work/stavemoor-lido",
              "name": "Stavemoor Lido identity",
              "order": 4,
              "summary": "A new name, mark and signs for an outdoor pool reopened by its swimmers after ten years closed.",
              "year": "2024"
            }
          }
        ],
        "name": "Projects"
      }
    },
