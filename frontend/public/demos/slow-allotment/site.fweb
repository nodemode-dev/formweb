            "border-radius": "var(--radius)",
            "display": "block",
            "height": "auto",
            "max-width": "100%",
            "width": "100%"
          },
          "tag": "img",
          "text": ""
        },
        "ab-lead": {
          "attrs": {},
          "breakpoints": {},
          "children": [],
          "id": "ab-lead",
          "name": "Ab lead",
          "styles": {
            "color": "var(--ink-soft)",
            "font-size": "var(--fs-lead)",
            "line-height": "1.55",
            "margin": "0 0 16px",
            "max-width": "60ch"
          },
          "tag": "p",
          "text": "The Slow Allotment is written by Tamsin Reed, who grows vegetables on plot 14 and writes about it when the rain keeps her indoors."
        },
        "ab-main": {
          "attrs": {},
          "breakpoints": {},
          "children": [
            "ab-hero"
          ],
          "id": "ab-main",
          "name": "Ab main",
          "styles": {},
          "tag": "main",
          "text": ""
        },
        "ab-p1": {
          "attrs": {},
          "breakpoints": {},
          "children": [],
          "id": "ab-p1",
          "name": "Ab p1",
          "styles": {
            "font-size": "1.1875rem",
            "margin": "0 0 16px",
            "max-width": "68ch"
          },
          "tag": "p",
          "text": "I started this journal to remember what I did and when: which beans cropped, which month the slugs won, how many leeks were too many. It turned out other people wanted to read it too."
        },
        "ab-p2": {
          "attrs": {},
          "breakpoints": {},
          "children": [],
          "id": "ab-p2",
          "name": "Ab p2",
          "styles": {
            "font-size": "1.1875rem",
            "margin": "0 0 16px",
            "max-width": "68ch"
          },
          "tag": "p",
          "text": "Nothing here is professional advice. It is one plot on heavy clay in a cold valley, and your ground will be different. Take what is useful and ignore the rest."
        },
        "ab-write-1": {
          "attrs": {},
          "breakpoints": {},
          "children": [],
          "id": "ab-write-1",
          "name": "Ab write 1",
          "styles": {},
          "tag": "span",
          "text": "Questions, corrections and seed-swap offers are all welcome at "
        },
        "ab-write-2": {
          "attrs": {},
          "breakpoints": {},
          "children": [],
          "id": "ab-write-2",
          "name": "Ab write 2",
          "styles": {},
          "tag": "span",
          "text": ". I answer most letters within a week, slower in the sowing season."
        },
