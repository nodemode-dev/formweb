        "ab-img": {
          "attrs": {
            "alt": "Drawing of an allotment at dusk: a wooden shed, a raised bed of young plants and low green hills under a yellow sun.",
            "decoding": "async",
            "fetchpriority": "high",
            "height": "700",
            "src": "/api/assets/0d7c33d18ca83f118d0992170abfa96d93138fd4a9c5a3300b5bf42d5e0de3b7.svg",
            "width": "1200"
          },
          "breakpoints": {},
          "children": [],
