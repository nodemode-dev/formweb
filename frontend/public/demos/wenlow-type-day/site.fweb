  "checkpoint": {
    "redo": [],
    "revision": 161,
    "schemaVersion": 1,
    "site": {
      "breakpoints": [
        {
          "id": "desktop",
          "maxWidth": 100000,
          "name": "Desktop"
        },
        {
          "id": "tablet",
