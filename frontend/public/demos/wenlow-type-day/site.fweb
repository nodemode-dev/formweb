          "styles": {
            "font-size": "1.125rem",
            "margin": "0 0 16px",
            "max-width": "68ch"
          },
          "tag": "p",
          "text": "Wenlow Type Day started in 2023 as an evening of talks in the back room of the library. It is now a full day in the Old Corn Exchange, still small enough that everyone gets lunch at the same long table."
        },
        "hm-about-p2": {
          "attrs": {},
          "breakpoints": {},
          "children": [],
          "id": "hm-about-p2",
          "name": "Hm about p2",
          "styles": {
