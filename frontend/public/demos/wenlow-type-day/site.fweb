{
  "format": "com.nodemode.formweb",
  "version": 1,
  "site": {
    "breakpoints": [
      {
        "id": "desktop",
        "maxWidth": 100000,
        "name": "Desktop"
      },
      {
        "id": "tablet",
        "maxWidth": 991,
        "name": "Tablet"
      },
      {
        "id": "mobile",
        "maxWidth": 767,
        "name": "Mobile"
      }
    ],
    "collections": {
      "speakers": {
        "fields": [
          {
            "name": "name",
            "required": true,
            "type": "text"
          },
          {
            "name": "role",
            "required": false,
            "type": "text"
          },
          {
            "name": "talk",
            "required": false,
            "type": "text"
          },
          {
            "name": "bio",
            "required": false,
            "type": "text"
          },
          {
            "name": "picture",
            "required": false,
            "type": "image"
          },
          {
            "name": "order",
            "required": false,
            "type": "number"
          }
        ],
        "id": "speakers",
        "items": [
          {
            "id": "speaker-ada-morrow",
            "slug": "ada-morrow",
            "status": "published",
            "values": {
              "bio": "Ada has spent four years drawing a family for the county's new road signs. She will show the tests on real roads that changed it most.",
              "name": "Ada Morrow",
              "order": 1,
              "picture": "/api/assets/a6fb8c0fd14479cf32a2b9460df036af0b8d9ab8bbcc8fc54501451aab693cf5.svg",
              "role": "Type designer, Morrow Letters",
              "talk": "Drawing a typeface for road signs"
            }
          },
          {
            "id": "speaker-kofi-asante",
            "slug": "kofi-asante",
            "status": "published",
            "values": {
              "bio": "Kofi paints shop signs by hand across three towns. His talk is about speed, spacing and what the weather does to enamel paint.",
              "name": "Kofi Asante",
              "order": 2,
              "picture": "/api/assets/7be806ea35a1df89e09efe2541546d5bb55302bf56a6afe0e569a76b800a7263.svg",
              "role": "Lettering artist",
              "talk": "Brush letters on shop fronts"
            }
          },
          {
            "id": "speaker-lena-vik",
            "slug": "lena-vik",
            "status": "published",
            "values": {
              "bio": "Lena designs poetry books for a two-person press. She will take one book apart, from margins to the last line of the colophon.",
              "name": "Lena Vik",
              "order": 3,
              "picture": "/api/assets/338c120d0b59aba066ef4947b4697f827668fde4383d2ede98c67b97e22634cf.svg",
              "role": "Book designer, Fieldmouse Press",
              "talk": "Small books, careful pages"
            }
          },
          {
            "id": "speaker-tom-reyes",
            "slug": "tom-reyes",
            "status": "published",
            "values": {
              "bio": "Tom builds websites for libraries. He measured what variable fonts cost on old phones and will share the numbers, good and bad.",
              "name": "Tom Reyes",
              "order": 4,
              "picture": "/api/assets/0b501b64125e1f3ab2896cbd491c6bcf3a5a3353fbe0b76268574c2e779ccdb5.svg",
              "role": "Developer and type nerd",
              "talk": "Variable fonts on slow phones"
            }
          },
          {
            "id": "speaker-hana-sato",
            "slug": "hana-sato",
            "status": "published",
            "values": {
              "bio": "Hana runs evening classes in Wenlow. Her session ends with five minutes of everyone writing the same word, badly and then better.",
              "name": "Hana Sato",
              "order": 5,
              "picture": "/api/assets/ee672406754a4c7c0e29fbec47e0df61d0a1f416a5aae3d5b8f1aebd765ffe5d.svg",
              "role": "Calligrapher and teacher",
              "talk": "Teaching the broad-edged pen"
            }
          },
          {
            "id": "speaker-ruth-calder",
            "slug": "ruth-calder",
            "status": "published",
            "values": {
              "bio": "Ruth found the order books of a type foundry that worked in Wenlow until 1931. She will show what they made and who bought it.",
              "name": "Ruth Calder",
              "order": 6,
              "picture": "/api/assets/151908cb53516fa0b8597f085304b16d03a3d5c69f6fe301d47511ae900ac0d4.svg",
              "role": "Archivist, Wenlow Museum",
              "talk": "The town's lost foundry"
            }
          }
        ],
        "name": "Speakers"
      }
    },
    "components": {
      "site-footer": {
        "id": "site-footer",
        "name": "Site footer",
        "root": "ft"
      },
      "site-header": {
        "id": "site-header",
        "name": "Site header",
        "root": "hd"
      }
    },
    "defaultLocale": "en",
