        },
        "slug": "/speakers"
      },
      {
        "id": "venue",
        "name": "Venue and travel",
        "root": "venue-root",
        "seo": {
          "description": "The Old Corn Exchange on Market Square, Wenlow: a map, how to get there by train, bike or car, step-free access and where to stay.",
          "noindex": false,
          "title": "Venue and travel · Wenlow Type Day 2027"
        },
        "slug": "/venue"
      },
      {
        "id": "tickets",
        "name": "Tickets",
        "root": "tickets-root",
        "seo": {
          "description": "Tickets from £45, open 1 March 2027. Reserve by email and pay by bank transfer; free places for students and people on low incomes.",
          "noindex": false,
          "title": "Tickets · Wenlow Type Day 2027"
        },
        "slug": "/tickets"
      },
      {
        "id": "not-found",
        "name": "Not found",
        "root": "not-found-root",
        "seo": {
          "description": "This page is not on the Wenlow Type Day site. See the programme or go back to the home page.",
          "noindex": true,
          "title": "Page not found · Wenlow Type Day 2027"
        },
        "slug": "/404"
