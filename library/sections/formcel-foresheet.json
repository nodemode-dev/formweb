{
  "format": "formweb-section",
  "version": 1,
  "id": "formcel-foresheet",
  "name": "FormCel foresheet",
  "category": "prompt-hero",
  "tags": ["prompt", "forecast", "chart", "csv", "drop", "spreadsheet", "hero"],
  "product": "formcel",
  "description": "Ask a FormCel sheet a question and get a forecast chart with a confidence band, from a typed prompt or a dropped table.",
  "source": "formai-xmental-webspun v3.1.0 assets/sections/formcel-foresheet",
  "preset": "formai-studio",
  "components": ["forecast-chart"],
  "fields": {
    "tint": { "label": "Tint", "type": "color", "default": "#3ecf8e" },
    "nameForm": { "label": "Product name, first part", "type": "text", "default": "Form" },
    "nameSuffix": { "label": "Product name, tinted part", "type": "text", "default": "Cel" },
    "eyebrow": { "label": "Eyebrow", "type": "text", "default": "Ask a sheet anything" },
    "ctaText": { "label": "Button text", "type": "text", "default": "See the FormCel page" },
    "ctaHref": { "label": "Button link", "type": "url", "default": "https://formai.studio/formcel/" },
    "photoDark": { "label": "Backdrop picture, dark theme", "type": "asset", "default": "https://media.formai.studio/media/formcel/ui-hero-2/c29707ac02cc.w2400.webp" },
    "photoLight": { "label": "Backdrop picture, light theme", "type": "asset", "default": "https://media.formai.studio/media/formcel/ui-hero-light-2/a66b1e40ff5d.w2400.webp" }
  },
  "tree": {
    "key": "section", "tag": "section", "name": "Foresheet hero",
    "attrs": {},
    "styles": {
      "--hue": "color-mix(in oklab, {{tint}} calc(100% - var(--hue-depth)), #000)",
      "--fc-uses": "var(--pane) var(--float) var(--control) var(--on-ink) var(--fault) var(--ink-faint) var(--ink-soft) var(--edge-strong) var(--ground) var(--sp-1) var(--sp-2) var(--sp-3) var(--sp-5) var(--sp-7) var(--fs-xs) var(--fs-m) var(--fs-l) var(--fs-xl) var(--fs-2xl) var(--font-ui) var(--font-mono) var(--weight-display) var(--track-display) var(--dur-fast) var(--control-h) var(--control-h-compact) var(--icon-m) var(--z-raised) var(--z-dropdown) var(--z-overlay)",
      "position": "relative",
      "isolation": "isolate",
      "overflow": "hidden",
      "height": "max(640px, calc(100svh - var(--bar-h)))",
      "display": "grid",
      "grid-template-columns": "minmax(0, 1fr)",
      "grid-template-rows": "auto 1fr",
      "border-bottom": "1px solid var(--edge)"
    },
    "breakpoints": { "mobile": { "height": "max(860px, calc(100svh - var(--bar-h)))" } },
    "children": [
      {
        "key": "photo", "tag": "figure", "name": "Backdrop picture",
        "attrs": { "aria-hidden": "true" },
        "styles": { "position": "absolute", "inset": "-4%", "z-index": "var(--z-behind)", "margin": "0", "translate": "var(--fc-px, 0px) var(--fc-py, 0px)" },
        "children": [
          {
            "key": "imgdark", "tag": "img", "name": "Picture, dark theme",
            "attrs": { "src": "{{photoDark}}", "width": "2400", "height": "1350", "alt": "", "decoding": "async", "data-fw-theme-only": "dark" },
            "styles": { "position": "absolute", "inset": "0", "width": "100%", "height": "100%", "object-fit": "cover", "object-position": "50% 30%", "filter": "brightness(calc(1 - 0.25 * var(--fc-done, 0))) saturate(calc(1 - 0.15 * var(--fc-done, 0)))", "transition": "filter 1.4s cubic-bezier(0.16, 1, 0.3, 1)" }
          },
          {
            "key": "imglight", "tag": "img", "name": "Picture, light theme",
            "attrs": { "src": "{{photoLight}}", "width": "2400", "height": "1350", "alt": "", "decoding": "async", "data-fw-theme-only": "light" },
            "styles": { "position": "absolute", "inset": "0", "width": "100%", "height": "100%", "object-fit": "cover", "object-position": "50% 30%", "filter": "brightness(calc(1 - 0.25 * var(--fc-done, 0))) saturate(calc(1 - 0.15 * var(--fc-done, 0)))", "transition": "filter 1.4s cubic-bezier(0.16, 1, 0.3, 1)" }
          }
        ]
      },
      {
        "key": "shade", "tag": "div", "name": "Shade",
        "attrs": { "aria-hidden": "true" },
        "styles": { "position": "absolute", "inset": "0", "z-index": "var(--z-behind)", "background": "radial-gradient(70% 60% at 50% 45%, color-mix(in srgb, var(--ground) 88%, transparent), color-mix(in srgb, var(--ground) 95%, transparent))" }
      },
      {
        "key": "rings", "tag": "div", "name": "Rings",
        "attrs": { "aria-hidden": "true" },
        "styles": {
          "--center-x": "50%",
          "--center-y": "44%",
          "position": "absolute",
          "z-index": "var(--z-behind)",
          "inset": "0",
          "background": "repeating-radial-gradient(circle at var(--center-x) var(--center-y), transparent 0 calc(var(--sp-9) - 1px), var(--edge-strong) calc(var(--sp-9) - 1px) var(--sp-9)), radial-gradient(circle at var(--center-x) var(--center-y), color-mix(in srgb, var(--hue-cut) 10%, transparent), transparent 40%), radial-gradient(circle at 30% calc(var(--center-y) + 15%), color-mix(in srgb, var(--hue-vis) 10%, transparent), transparent 35%), radial-gradient(circle at 70% calc(var(--center-y) + 15%), color-mix(in srgb, var(--hue-wav) 9%, transparent), transparent 35%)",
          "mask-image": "radial-gradient(circle at var(--center-x) var(--center-y), #000 25%, transparent 75%)"
        }
      },
      {
        "key": "floor", "tag": "div", "name": "Floor grid",
        "attrs": { "aria-hidden": "true" },
        "styles": {
          "position": "absolute", "left": "0", "right": "0", "bottom": "0", "z-index": "var(--z-behind)", "height": "44%",
          "perspective": "420px", "pointer-events": "none",
          "opacity": "calc(0.28 + 0.32 * var(--fc-busy, 0))",
          "transition": "opacity 0.6s var(--ease-out)",
          "mask-image": "linear-gradient(to top, #000 10%, transparent)"
        },
        "children": [
          {
            "key": "plane", "tag": "div", "name": "Floor plane",
            "styles": { "position": "absolute", "top": "-80%", "left": "-50%", "right": "-50%", "bottom": "0", "transform": "rotateX(72deg)", "transform-origin": "50% 100%" },
            "children": [
              {
                "key": "lines", "tag": "div", "name": "Floor lines",
                "styles": {
                  "position": "absolute", "top": "-64px", "left": "0", "right": "0", "bottom": "0",
                  "background-image": "linear-gradient(var(--ink-faint) 1px, transparent 1px), linear-gradient(90deg, var(--ink-faint) 1px, transparent 1px)",
                  "background-size": "64px 64px"
                }
              }
            ]
          }
        ]
      },
      {
        "key": "top", "tag": "div", "name": "Top bar",
        "styles": {
          "position": "relative", "z-index": "var(--z-sticky)", "display": "grid", "grid-template-columns": "1fr auto 1fr", "align-items": "center",
          "gap": "var(--sp-4)", "padding": "var(--sp-3) var(--sp-5)", "border-bottom": "1px solid var(--edge)"
        },
        "breakpoints": { "mobile": { "grid-template-columns": "1fr auto", "padding": "var(--sp-3) var(--sp-3)" } },
        "children": [
          { "key": "slot", "tag": "div", "name": "Horizon picker slot", "attrs": { "aria-hidden": "true" }, "styles": { "min-height": "var(--control-h)" }, "breakpoints": { "mobile": { "min-width": "132px" } } },
          {
            "key": "word", "tag": "span", "name": "Wordmark",
            "styles": { "font-family": "var(--font-mono)", "font-size": "var(--fs-s)", "letter-spacing": "0.4em", "text-transform": "uppercase" },
            "breakpoints": { "mobile": { "display": "none" } },
            "children": [
              { "key": "wordform", "tag": "span", "name": "Name, first part", "text": "{{nameForm}}" },
              { "key": "wordsuf", "tag": "span", "name": "Name, tinted part", "text": "{{nameSuffix}}" }
            ]
          },
          {
            "key": "cta", "tag": "a", "name": "Button",
            "attrs": { "href": "{{ctaHref}}" },
            "styles": {
              "justify-self": "end", "display": "inline-flex", "align-items": "center", "justify-content": "center", "gap": "var(--sp-2)",
              "height": "48px", "padding": "0 var(--sp-5)", "border-radius": "0", "background": "transparent", "color": "var(--ink)",
              "box-shadow": "inset 0 0 0 1px var(--edge-strong)", "font-family": "var(--font-mono)", "font-size": "var(--fs-xs)", "font-weight": "500",
              "letter-spacing": "0.14em", "text-transform": "uppercase", "text-decoration": "none", "white-space": "nowrap",
              "transition": "background-color var(--dur-fast) var(--ease-out), translate 0.3s cubic-bezier(0.34, 1.45, 0.64, 1)"
            },
            "breakpoints": { "mobile": { "height": "auto", "min-height": "var(--control-h)", "padding": "var(--sp-2) var(--sp-5)", "white-space": "normal", "text-align": "left" } },
            "children": [
              { "key": "ctatext", "tag": "span", "name": "Button text", "text": "{{ctaText}}" },
              {
                "key": "ctaicon", "tag": "svg", "name": "Arrow",
                "attrs": { "viewBox": "0 0 24 24", "fill": "none", "stroke": "currentColor", "stroke-width": "1.75", "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true" },
                "styles": { "flex": "none", "display": "block", "width": "var(--icon-m)", "height": "var(--icon-m)" },
                "children": [
                  { "key": "ctap1", "tag": "path", "attrs": { "d": "M5 12h14" } },
                  { "key": "ctap2", "tag": "path", "attrs": { "d": "M13 6l6 6-6 6" } }
                ]
              }
            ]
          }
        ]
      },
      {
        "key": "stack", "tag": "div", "name": "Prompt stack",
        "styles": {
          "position": "relative", "z-index": "var(--z-raised)", "display": "flex", "flex-direction": "column", "align-items": "center", "justify-content": "center",
          "gap": "var(--sp-4)", "padding": "var(--sp-5) var(--sp-4) calc(14svh + 22svh * var(--fc-done, 0))", "text-align": "center",
          "transition": "padding 1s cubic-bezier(0.16, 1, 0.3, 1)"
        },
        "breakpoints": { "mobile": { "padding": "var(--sp-5) var(--sp-4) calc(14svh + (270px - 14svh) * var(--fc-done, 0))" } },
        "children": [
          {
            "key": "eyebrow", "tag": "p", "name": "Eyebrow", "text": "{{eyebrow}}",
            "styles": { "margin": "0", "color": "var(--ink-soft)", "font-family": "var(--font-mono)", "font-size": "var(--fs-xs)", "letter-spacing": "0.3em", "text-transform": "uppercase" }
          },
          {
            "key": "h1", "tag": "h1", "name": "Heading",
            "styles": {
              "margin": "0", "font-size": "calc(min(84px, 7vw) + (clamp(32px, 4.4vw, 56px) - min(84px, 7vw)) * var(--fc-done, 0))",
              "font-weight": "720", "line-height": "1", "letter-spacing": "-0.045em", "transition": "font-size 1s cubic-bezier(0.16, 1, 0.3, 1)"
            },
            "breakpoints": { "mobile": { "font-size": "calc(44px - 12px * var(--fc-done, 0))" } },
            "children": [
              { "key": "h1lead", "tag": "span", "name": "Lead word", "text": "Ask ", "styles": { "white-space": "pre" } },
              { "key": "h1form", "tag": "span", "name": "Name, first part", "text": "{{nameForm}}" },
              { "key": "h1suf", "tag": "span", "name": "Name, tinted part", "text": "{{nameSuffix}}" },
              { "key": "h1dot", "tag": "span", "name": "Full stop", "text": "." }
            ]
          },
          {
            "key": "ask", "tag": "div", "name": "Prompt panel (forecast chart)",
            "styles": { "position": "relative", "width": "100%", "max-width": "600px", "height": "274px" },
            "breakpoints": { "mobile": { "height": "314px" } }
          },
          {
            "key": "subwrap", "tag": "div", "name": "Note",
            "styles": {
              "color": "var(--ink-soft)", "font-size": "var(--fs-m)", "overflow": "hidden",
              "max-height": "calc(6em * (1 - var(--fc-done, 0)))",
              "margin-top": "calc(var(--sp-4) * -1 * var(--fc-done, 0))",
              "opacity": "calc(1 - var(--fc-done, 0))",
              "transform": "translateY(calc(12px * var(--fc-done, 0)))",
              "transition": "opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out), max-height 0.8s cubic-bezier(0.16, 1, 0.3, 1), margin 0.8s cubic-bezier(0.16, 1, 0.3, 1)"
            },
            "children": [
              {
                "key": "sub", "tag": "p", "name": "Note text",
                "styles": { "margin": "0" },
                "children": [
                  { "key": "sub1", "tag": "span", "name": "Note line one", "text": "Reads .csv, .tsv and .txt tables.", "styles": { "display": "block" } },
                  {
                    "key": "sub2", "tag": "span", "name": "Note line two", "text": "Runs here. Uploads nothing.",
                    "styles": { "display": "block", "margin-top": "var(--sp-1)", "color": "var(--ink-faint)", "font-family": "var(--font-mono)", "font-size": "var(--fs-xs)", "letter-spacing": "0.14em", "text-transform": "uppercase" }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "commands": [
    { "command": "textpreset.apply", "params": { "id": "@@wordform@@", "name": "app-form" } },
    { "command": "textpreset.apply", "params": { "id": "@@wordsuf@@", "name": "app-suffix" } },
    { "command": "textpreset.apply", "params": { "id": "@@h1form@@", "name": "app-form" } },
    { "command": "textpreset.apply", "params": { "id": "@@h1suf@@", "name": "app-suffix" } },
    { "command": "motion.set", "params": { "kind": "reveals", "node": "@@top@@", "value": { "from": { "opacity": "0" }, "duration": 1200, "delay": 600, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "trigger": "load" } } },
    { "command": "motion.set", "params": { "kind": "reveals", "node": "@@eyebrow@@", "value": { "from": { "opacity": "0", "translate": "0 18px", "filter": "blur(8px)" }, "duration": 1200, "delay": 500, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "trigger": "load" } } },
    { "command": "motion.set", "params": { "kind": "reveals", "node": "@@h1@@", "value": { "from": { "opacity": "0", "translate": "0 18px", "filter": "blur(8px)" }, "duration": 1300, "delay": 600, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "trigger": "load" } } },
    { "command": "motion.set", "params": { "kind": "reveals", "node": "@@sub@@", "value": { "from": { "opacity": "0", "translate": "0 18px", "filter": "blur(8px)" }, "duration": 1200, "delay": 950, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "trigger": "load" } } },
    { "command": "motion.set", "params": { "kind": "reveals", "node": "@@imgdark@@", "value": { "from": { "filter": "brightness(0.05) saturate(0.2)", "scale": "1.08" }, "duration": 3000, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "trigger": "load" } } },
    { "command": "motion.set", "params": { "kind": "reveals", "node": "@@imglight@@", "value": { "from": { "filter": "brightness(0.05) saturate(0.2)", "scale": "1.08" }, "duration": 3000, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "trigger": "load" } } },
    { "command": "motion.set", "params": { "kind": "loops", "node": "@@lines@@", "value": { "type": "keyframes", "duration": 4000, "easing": "linear", "iterations": "infinite", "pauseOffscreen": true, "keyframes": [ { "at": 0, "styles": { "translate": "0 0" } }, { "at": 1, "styles": { "translate": "0 64px" } } ] } } },
    { "command": "code.instance.set", "params": { "node": "@@ask@@", "value": { "component": "forecast-chart", "props": { "productForm": "{{nameForm}}", "productSuffix": "{{nameSuffix}}" } } } }
  ],
  "behaviors": {
    "@@cta@@": { "states": { "hover": { "background": "var(--control)", "translate": "0 -1px" }, "press": { "scale": "0.96" } } }
  }
}
