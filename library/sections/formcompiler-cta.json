    "headline": { "label": "Headline", "type": "text", "default": "What if a release took one push?" },
    "intro": { "label": "Intro after the name", "type": "longtext", "default": "checks it, builds every listed platform, signs it and leaves a draft release for you to publish." },
    "lead": { "label": "Intro before the name", "type": "text", "default": "Push a compile branch from main." },
    "button": { "label": "Button text", "type": "text", "default": "See FormCompiler" },
    "link": { "label": "Button link", "type": "url", "default": "https://formai.studio/formcompiler/" },
    "fine": { "label": "Small print", "type": "text", "default": "Free, open source, no account needed." },
