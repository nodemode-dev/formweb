{
  "format": "formweb-section",
  "version": 1,
  "id": "formcompiler-cta",
  "name": "FormCompiler call to action",
  "category": "product-site",
  "tags": ["cta", "closing", "button", "hover"],
  "product": "formcompiler",
  "description": "A closing call to action for FormCompiler: push a compile branch and get a draft release.",
