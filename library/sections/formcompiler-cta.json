    { "command": "textpreset.apply", "params": { "id": "@@btn@@", "name": "button" } },
    { "command": "node.update", "params": { "id": "@@btn@@", "patch": { "styles": { "padding-left": "calc(var(--control-h) + var(--sp-4))", "padding-right": "var(--sp-5)" } } } },
    { "command": "motion.set", "params": { "kind": "reveals", "node": "@@h@@", "value": { "from": { "opacity": "0", "transform": "translateY(45px)", "filter": "blur(10px)" }, "duration": 800, "delay": 150, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "rootMargin": "0px 0px -10% 0px", "threshold": 0, "once": true, "trigger": "view" } } },
    { "command": "motion.set", "params": { "kind": "reveals", "node": "@@p@@", "value": { "from": { "opacity": "0", "transform": "translateY(45px)", "filter": "blur(10px)" }, "duration": 800, "delay": 150, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "rootMargin": "0px 0px -10% 0px", "threshold": 0, "once": true, "trigger": "view" } } },
