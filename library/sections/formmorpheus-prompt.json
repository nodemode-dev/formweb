    { "command": "motion.set", "params": { "kind": "reveals", "node": "@@h@@", "value": { "from": { "opacity": "0", "transform": "translateY(24px)" }, "duration": 1200, "delay": 250, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "trigger": "load" } } },
    { "command": "motion.set", "params": { "kind": "reveals", "node": "@@h-line@@", "value": { "from": { "transform": "scaleX(0)" }, "duration": 1000, "delay": 1200, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "trigger": "load" } } },
