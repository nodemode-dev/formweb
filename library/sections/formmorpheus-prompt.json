    { "command": "motion.set", "params": { "kind": "reveals", "node": "@@right@@", "value": { "from": { "opacity": "0", "transform": "translateY(24px)" }, "duration": 1200, "delay": 500, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "trigger": "load" } } },
