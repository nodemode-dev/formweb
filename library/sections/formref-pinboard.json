{
  "format": "formweb-section",
  "version": 1,
  "id": "formref-pinboard",
  "name": "FormRef board",
  "category": "portfolio-hero",
  "tags": ["infinite canvas", "pinboard", "drag", "zoom", "lightbox", "captures"],
  "product": "formref",
  "description": "A FormRef board of sixteen real captures on an infinite canvas: drag pieces, zoom around the pointer, fit them all, tidy them into columns and open any one full size.",
  "source": "formai-xmental-webspun v3.1.0 assets/sections/formref-pinboard",
  "preset": "formai-studio",
  "components": ["infinite-board"],
  "fields": {
    "tint": { "label": "Tint", "type": "color", "default": "#c9a27a" },
    "name": { "label": "Product name", "type": "text", "default": "FormRef" },
    "role": { "label": "Role line", "type": "text", "default": "Reference board app, instead of PureRef and Milanote" },
    "about_title": { "label": "About heading", "type": "text", "default": "A free canvas for references" },
    "about_body": { "label": "About text", "type": "longtext", "default": "Collect images and files, arrange them on a free canvas, add notes and tasks, and connect ideas. A Rust engine owns geometry, locking, grouping, arrangement and undo." },
    "get_url": { "label": "Product address", "type": "url", "default": "https://formai.studio/formref/" }
  },
  "tree": {
    "key": "section", "tag": "section", "name": "FormRef board",
    "attrs": { "aria-label": "{{name}} board of sixteen captures" },
    "styles": {
      "--hue": "color-mix(in oklab, {{tint}} calc(100% - var(--hue-depth)), #000)",
      "--g": "clamp(14px, 1.6vw, 24px)",
      "position": "relative", "isolation": "isolate", "overflow": "clip",
      "height": "calc(100svh - var(--bar-h))", "min-height": "620px",
      "background": "var(--ground)"
    },
    "breakpoints": { "mobile": { "height": "calc(100svh - var(--bar-h) - 33px)" } },
    "children": [
      {
        "key": "top", "tag": "div", "name": "Top bar",
        "styles": {
          "position": "absolute", "left": "0", "right": "0", "top": "0", "z-index": "var(--z-chrome)",
          "display": "grid", "grid-template-columns": "1fr auto 1fr", "align-items": "start",
          "padding": "calc(var(--g) + 4px) var(--g) 36px",
          "background": "linear-gradient(to bottom, var(--ground) 30%, transparent)",
          "pointer-events": "none"
        },
        "breakpoints": { "mobile": { "grid-template-columns": "auto 1fr auto" } },
        "children": [
          {
            "key": "navl", "tag": "nav", "name": "Page links", "attrs": { "aria-label": "Page" },
            "styles": { "display": "flex", "gap": "var(--sp-4)", "pointer-events": "auto" },
            "breakpoints": { "mobile": { "gap": "var(--sp-3)" } },
            "children": [
              {
                "key": "overview", "tag": "a", "name": "Overview link", "text": "Overview",
                "attrs": { "href": "{{get_url}}", "aria-current": "page" },
                "styles": {
                  "display": "inline-flex", "align-items": "center", "min-height": "var(--control-h-compact)",
                  "color": "var(--ink)", "font-family": "var(--font-mono)", "font-size": "var(--fs-xs)",
                  "letter-spacing": ".14em", "text-transform": "uppercase", "text-decoration": "underline"
                }
              }
            ]
          },
          {
            "key": "mark", "tag": "h1", "name": "Wordmark", "attrs": { "aria-label": "{{name}} board" },
            "styles": {
              "display": "flex", "align-items": "center", "margin": "0 -.5em 0 0",
              "min-height": "var(--control-h-compact)", "color": "var(--ink)",
              "font-family": "var(--font-mono)", "font-size": "clamp(12px, 1.2vw, 15px)", "font-weight": "500",
              "letter-spacing": ".5em", "text-transform": "uppercase", "white-space": "nowrap", "pointer-events": "auto"
            },
            "breakpoints": { "mobile": { "justify-self": "center", "margin": "0 -.3em 0 0", "font-size": "11px", "letter-spacing": ".3em" } },
            "children": [
              { "key": "mk0", "tag": "span", "text": "F", "attrs": { "aria-hidden": "true" }, "styles": { "display": "inline-block", "color": "var(--ink)" } },
              { "key": "mk1", "tag": "span", "text": "o", "attrs": { "aria-hidden": "true" }, "styles": { "display": "inline-block", "color": "var(--ink)" } },
              { "key": "mk2", "tag": "span", "text": "r", "attrs": { "aria-hidden": "true" }, "styles": { "display": "inline-block", "color": "var(--ink)" } },
              { "key": "mk3", "tag": "span", "text": "m", "attrs": { "aria-hidden": "true" }, "styles": { "display": "inline-block", "color": "var(--ink)" } },
              { "key": "mk4", "tag": "span", "text": "R", "attrs": { "aria-hidden": "true" }, "styles": { "display": "inline-block", "color": "var(--hue)" } },
              { "key": "mk5", "tag": "span", "text": "e", "attrs": { "aria-hidden": "true" }, "styles": { "display": "inline-block", "color": "var(--hue)" } },
              { "key": "mk6", "tag": "span", "text": "f", "attrs": { "aria-hidden": "true" }, "styles": { "display": "inline-block", "color": "var(--hue)" } },
              { "key": "mksp", "tag": "span", "attrs": { "aria-hidden": "true" }, "styles": { "display": "inline-block", "width": ".5em" } },
              { "key": "mk7", "tag": "span", "text": "B", "attrs": { "aria-hidden": "true" }, "styles": { "display": "inline-block", "color": "var(--ink-faint)" } },
              { "key": "mk8", "tag": "span", "text": "o", "attrs": { "aria-hidden": "true" }, "styles": { "display": "inline-block", "color": "var(--ink-faint)" } },
              { "key": "mk9", "tag": "span", "text": "a", "attrs": { "aria-hidden": "true" }, "styles": { "display": "inline-block", "color": "var(--ink-faint)" } },
              { "key": "mk10", "tag": "span", "text": "r", "attrs": { "aria-hidden": "true" }, "styles": { "display": "inline-block", "color": "var(--ink-faint)" } },
              { "key": "mk11", "tag": "span", "text": "d", "attrs": { "aria-hidden": "true" }, "styles": { "display": "inline-block", "color": "var(--ink-faint)" } }
            ]
          },
          {
            "key": "navr", "tag": "div", "name": "Card buttons",
            "styles": { "display": "flex", "justify-content": "flex-end", "gap": "var(--sp-4)", "pointer-events": "auto" },
            "breakpoints": { "mobile": { "gap": "var(--sp-3)" } },
            "children": [
              {
                "key": "aboutBtn", "tag": "button", "name": "About button", "text": "About",
                "attrs": { "type": "button" },
                "styles": {
                  "display": "inline-flex", "align-items": "center", "min-height": "var(--control-h-compact)", "margin": "0", "padding": "0",
                  "border": "0", "background": "none", "color": "var(--ink)", "font-family": "var(--font-mono)", "font-size": "var(--fs-xs)",
                  "letter-spacing": ".14em", "text-transform": "uppercase", "cursor": "pointer"
                }
              },
              {
                "key": "contactBtn", "tag": "button", "name": "Get it button", "text": "Get it",
                "attrs": { "type": "button" },
                "styles": {
                  "display": "inline-flex", "align-items": "center", "min-height": "var(--control-h-compact)", "margin": "0", "padding": "0",
                  "border": "0", "background": "none", "color": "var(--ink)", "font-family": "var(--font-mono)", "font-size": "var(--fs-xs)",
                  "letter-spacing": ".14em", "text-transform": "uppercase", "cursor": "pointer"
                }
              }
            ]
          }
        ]
      },
      {
        "key": "aboutPanel", "tag": "section", "name": "About card", "attrs": { "aria-label": "About {{name}}" },
        "styles": {
          "position": "absolute", "top": "58px", "right": "var(--g)", "z-index": "var(--z-popover)",
          "width": "min(330px, calc(100% - 28px))"
        },
        "children": [
          {
            "key": "aboutWrap", "tag": "div", "name": "About surface",
            "styles": { "border-radius": "var(--radius-l)", "background": "var(--pane)", "box-shadow": "inset 0 0 0 1px var(--edge-strong), var(--shadow-frame)" },
            "children": [
              {
                "key": "aboutBody", "tag": "div", "name": "About content", "styles": { "padding": "var(--sp-5)" },
                "children": [
                  { "key": "aboutRole", "tag": "p", "name": "Role", "text": "{{role}}", "styles": { "margin": "0", "color": "var(--ink-faint)", "font-family": "var(--font-mono)", "font-size": "var(--fs-xs)", "letter-spacing": ".14em", "text-transform": "uppercase" } },
                  { "key": "aboutTitle", "tag": "h2", "name": "About heading", "text": "{{about_title}}", "styles": { "margin": "var(--sp-2) 0 0", "font-size": "var(--fs-l)", "font-weight": "var(--weight-display)", "letter-spacing": "var(--track-tight)", "line-height": "1.2" } },
                  { "key": "aboutText", "tag": "p", "name": "About text", "text": "{{about_body}}", "styles": { "margin": "var(--sp-2) 0 0", "color": "var(--ink-soft)", "font-size": "var(--fs-s)", "line-height": "1.55" } },
                  { "key": "aboutLab", "tag": "p", "name": "Imports label", "text": "Imports and exports", "styles": { "margin": "var(--sp-4) 0 0", "color": "var(--ink-faint)", "font-family": "var(--font-mono)", "font-size": "var(--fs-xs)", "letter-spacing": ".14em", "text-transform": "uppercase" } },
                  {
                    "key": "aboutNames", "tag": "ul", "name": "Import formats",
                    "styles": { "display": "flex", "flex-wrap": "wrap", "gap": "var(--sp-1) var(--sp-3)", "margin": "var(--sp-1) 0 0", "padding": "0", "list-style": "none", "font-size": "var(--fs-s)" },
                    "children": [
                      { "key": "fmt0", "tag": "li", "text": "BeeRef .bee" },
                      { "key": "fmt1", "tag": "li", "text": "iStack" },
                      { "key": "fmt2", "tag": "li", "text": "Markdown" },
                      { "key": "fmt3", "tag": "li", "text": "PDF" }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "key": "contactPanel", "tag": "section", "name": "Get it card", "attrs": { "aria-label": "Get {{name}}" },
        "styles": {
          "position": "absolute", "top": "58px", "right": "var(--g)", "z-index": "var(--z-popover)",
          "width": "min(330px, calc(100% - 28px))"
        },
        "children": [
          {
            "key": "contactWrap", "tag": "div", "name": "Get it surface",
            "styles": { "border-radius": "var(--radius-l)", "background": "var(--pane)", "box-shadow": "inset 0 0 0 1px var(--edge-strong), var(--shadow-frame)" },
            "children": [
              {
                "key": "contactBody", "tag": "div", "name": "Get it content", "styles": { "padding": "var(--sp-5)" },
                "children": [
                  {
                    "key": "status", "tag": "div", "name": "Status",
                    "styles": { "display": "flex", "align-items": "center", "gap": "var(--sp-2)", "font-family": "var(--font-mono)", "font-size": "var(--fs-xs)", "letter-spacing": ".14em", "text-transform": "uppercase" },
                    "children": [
                      { "key": "pulse", "tag": "span", "name": "Pulse", "attrs": { "aria-hidden": "true" }, "styles": { "display": "block", "width": "8px", "height": "8px", "background": "var(--hue)" } },
                      { "key": "statusText", "tag": "span", "text": "Free, no account" }
                    ]
                  },
                  {
                    "key": "mailRow", "tag": "button", "name": "Copy address", "attrs": { "type": "button" },
                    "styles": {
                      "display": "flex", "align-items": "center", "justify-content": "space-between", "gap": "var(--sp-3)", "width": "100%", "box-sizing": "border-box",
                      "margin": "var(--sp-3) 0 0", "padding": "var(--sp-2) var(--sp-3)", "border": "0", "border-radius": "var(--radius-m)",
                      "background": "var(--control)", "box-shadow": "inset 0 0 0 1px var(--edge-strong)", "color": "var(--ink)", "cursor": "pointer", "text-align": "start"
                    },
                    "children": [
                      { "key": "mailSt", "tag": "span", "name": "Copy state", "text": "Copy", "styles": { "order": "2", "min-width": "11ch", "color": "var(--ink-faint)", "font-family": "var(--font-mono)", "font-size": "var(--fs-xs)", "letter-spacing": ".14em", "text-align": "end", "text-transform": "uppercase" } },
                      { "key": "mailCode", "tag": "code", "name": "Address", "text": "formai.studio/formref/", "styles": { "order": "1", "font-family": "var(--font-mono)", "font-size": "var(--fs-s)", "user-select": "all" } }
                    ]
                  },
                  {
                    "key": "btnRow", "tag": "div", "name": "Buttons",
                    "styles": { "display": "grid", "grid-template-columns": "1fr 1fr", "gap": "var(--sp-2)", "margin": "var(--sp-3) 0 0" },
                    "children": [
                      { "key": "btnGet", "tag": "a", "name": "Download button", "text": "Download", "attrs": { "href": "{{get_url}}download/" },
                        "styles": { "display": "inline-flex", "align-items": "center", "justify-content": "center", "gap": "var(--sp-2)", "height": "var(--control-h)", "padding": "0 var(--sp-3)", "border-radius": "var(--radius-m)", "background": "var(--ink)", "color": "var(--on-ink)", "font-size": "11px", "letter-spacing": ".1em", "font-weight": "var(--weight-strong)", "text-decoration": "none", "white-space": "nowrap", "transition": "background-color .5s var(--ease-out), color .5s var(--ease-out)" } },
                      { "key": "btnFeat", "tag": "a", "name": "Features button", "text": "Features", "attrs": { "href": "{{get_url}}features/" },
                        "styles": { "display": "inline-flex", "align-items": "center", "justify-content": "center", "gap": "var(--sp-2)", "height": "var(--control-h)", "padding": "0 var(--sp-3)", "border-radius": "var(--radius-m)", "background": "var(--control)", "color": "var(--ink)", "font-size": "11px", "letter-spacing": ".1em", "font-weight": "var(--weight-strong)", "text-decoration": "none", "white-space": "nowrap", "transition": "background-color .5s var(--ease-out), color .5s var(--ease-out)" } }
                    ]
                  },
                  {
                    "key": "socials", "tag": "div", "name": "Links",
                    "styles": { "display": "flex", "flex-wrap": "wrap", "gap": "var(--sp-4)", "margin": "var(--sp-4) 0 0", "font-size": "var(--fs-s)" },
                    "children": [
                      { "key": "soc0", "tag": "a", "text": "Docs", "attrs": { "href": "{{get_url}}docs/" }, "styles": { "color": "inherit" } },
                      { "key": "soc1", "tag": "a", "text": "Releases", "attrs": { "href": "{{get_url}}releases/" }, "styles": { "color": "inherit" } },
                      { "key": "soc2", "tag": "a", "text": "Open source", "attrs": { "href": "{{get_url}}open-source/" }, "styles": { "color": "inherit" } }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "commands": [
    { "command": "code.instance.set", "params": { "node": "@@section@@", "value": { "component": "infinite-board", "props": { "hint": "16 captures · drag, scroll to zoom", "metaSuffix": " · FormRef 0.38.3" } } } },
    { "command": "motion.set", "params": { "kind": "disclosure", "node": "@@section@@", "value": { "type": "accordion", "single": true, "items": [
      { "trigger": "@@aboutBtn@@", "panel": "@@aboutPanel@@" },
      { "trigger": "@@contactBtn@@", "panel": "@@contactPanel@@" }
    ] } } },
    { "command": "motion.set", "params": { "kind": "actions", "node": "@@mailRow@@", "value": [ { "trigger": "click", "action": "copy", "text": "https://formai.studio/formref/", "feedback": "Copied" } ] } },
    { "command": "motion.set", "params": { "kind": "reveals", "node": "@@mark@@", "value": { "from": { "opacity": "0", "transform": "translateY(-10px)", "filter": "blur(4px)" }, "children": true, "duration": 1100, "delay": 200, "stagger": 45, "easing": "ease-out", "trigger": "load", "once": true } } },
    { "command": "motion.set", "params": { "kind": "reveals", "node": "@@navl@@", "value": { "from": { "opacity": "0" }, "duration": 1000, "delay": 500, "easing": "ease-out", "trigger": "load", "once": true } } },
    { "command": "motion.set", "params": { "kind": "reveals", "node": "@@navr@@", "value": { "from": { "opacity": "0" }, "duration": 1000, "delay": 500, "easing": "ease-out", "trigger": "load", "once": true } } },
    { "command": "motion.set", "params": { "kind": "loops", "node": "@@pulse@@", "value": { "type": "keyframes", "duration": 1800, "iterations": "infinite", "easing": "ease-in-out", "keyframes": [ { "at": 0, "styles": { "opacity": "1" } }, { "at": 0.5, "styles": { "opacity": "0.3" } }, { "at": 1, "styles": { "opacity": "1" } } ] } } }
  ],
  "behaviors": {
    "@@overview@@": { "states": { "hover": { "text-decoration": "underline" } } },
    "@@aboutBtn@@": { "states": { "hover": { "text-decoration": "underline" } } },
    "@@contactBtn@@": { "states": { "hover": { "text-decoration": "underline" } } },
    "@@mailRow@@": { "states": { "hover": { "background": "var(--control-hover)" } } },
    "@@btnGet@@": { "states": { "hover": { "background": "var(--hue)", "color": "var(--on-ink)" } } },
    "@@btnFeat@@": { "states": { "hover": { "background": "var(--ink)", "color": "var(--on-ink)" } } }
  }
}
