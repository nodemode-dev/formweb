  "commands": [
    { "command": "textpreset.apply", "params": { "id": "@@heading@@", "name": "heading" } },
    { "command": "textpreset.apply", "params": { "id": "@@h-form@@", "name": "app-form" } },
    { "command": "textpreset.apply", "params": { "id": "@@h-suffix@@", "name": "app-suffix" } },
    { "command": "textpreset.apply", "params": { "id": "@@btn@@", "name": "button" } },
    { "command": "node.update", "params": { "id": "@@heading@@", "patch": { "styles": { "line-height": "1.1" } } } },
    { "command": "node.update", "params": { "id": "@@btn@@", "patch": { "styles": { "font-family": "var(--font-mono)", "font-size": "var(--fs-xs)", "font-weight": "500", "letter-spacing": "0.14em", "text-transform": "uppercase", "border-radius": "0", "height": "48px", "padding-left": "var(--sp-5)", "padding-right": "var(--sp-5)" } } } },
    { "command": "motion.set", "params": { "kind": "loops", "node": "@@row-1@@", "value": { "type": "marquee", "direction": "left", "speed": 30, "pauseOffscreen": true } } },
    { "command": "motion.set", "params": { "kind": "loops", "node": "@@row-2@@", "value": { "type": "marquee", "direction": "right", "speed": 30, "pauseOffscreen": true } } }
